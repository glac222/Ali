# Copia este archivo a php/.env y completa los valores en el servidor.
# php/.env NUNCA se sube a git.

# --- Base de datos MariaDB (creala en hPanel > Bases de datos MySQL) ---
DB_HOST=localhost
DB_NAME=uXXXXXXXX_micocina
DB_USER=uXXXXXXXX_micocina
DB_PASS=

# --- Chat IA (DeepSeek) ---
# Si se deja vacio, el chat responde en modo simulado (igual que el mockup).
DEEPSEEK_API_KEY=

# --- Token para correr migraciones/seed por HTTP (sin SSH) ---
# Genera algo largo y aleatorio. Se usa asi:
#   https://ali.calimundo.com/api/admin/migrate?token=EL_TOKEN
#   https://ali.calimundo.com/api/admin/seed?token=EL_TOKEN
#   https://ali.calimundo.com/api/admin/seed?token=EL_TOKEN&force=1
ADMIN_TOKEN=

# Opcional: origen permitido para CORS. Por defecto '*'.
CORS_ORIGIN=*
